 "<section class=\"page-hero page-hero--contact\">\n<img alt=\"\" class=\"page-hero__image\" fetchpriority=\"high\" height=\"887\" src=\"assets/img/heroes/contact-office.webp\" width=\"1774\"/>\n<div class=\"container\">\n<span class=\"eyebrow\">Contact</span>\n<h1>Let's talk about your project</h1>\n<p>Tell us a little about what you need. We'll get back to you to discuss the scope and next steps.</p>\n</div>\n</section>",
 "<section class=\"section\">\n<div class=\"container contact-grid\">\n<!-- To send inquiries without opening the visitor's email app, set data-endpoint to a form service URL (e.g. https://formspree.io/f/xxxxxxx). -->\n<form class=\"form\" data-endpoint=\"\" id=\"inquiry-form\" novalidate=\"\">\n<h2>Book a consultation</h2>\n<p class=\"field__hint\" style=\"margin-bottom:24px\">Fields marked <span class=\"accent\">*</span> are required.</p>\n<div class=\"form__row\">\n<div class=\"field\">\n<label for=\"name\">Full name <span class=\"req\">*</span></label>\n<input autocomplete=\"name\" id=\"name\" name=\"name\" required=\"\" type=\"text\"/>\n<span class=\"field__error\">Please enter your name.</span>\n</div>\n<div class=\"field\">\n<label for=\"organization\">Organisation <span class=\"req\">*</span></label>\n<input autocomplete=\"organization\" id=\"organization\" name=\"organization\" required=\"\" type=\"text\"/>\n<span class=\"field__error\">Please enter your organisation.</span>\n</div>\n</div>\n<div class=\"form__row\">\n<div class=\"field\">\n<label for=\"email\">Work email <span class=\"req\">*</span></label>\n<input autocomplete=\"email\" id=\"email\" name=\"email\" required=\"\" type=\"email\"/>\n<span class=\"field__error\">Please enter a valid email address.</span>\n</div>\n<div class=\"field\">\n<label for=\"phone\">Phone</label>\n<input autocomplete=\"tel\" id=\"phone\" name=\"phone\" type=\"tel\"/>\n</div>\n</div>\n<div class=\"form__row\">\n<div class=\"field\">\n<label for=\"service\">Service needed <span class=\"req\">*</span></label>\n<select id=\"service\" name=\"service\" required=\"\">\n<option value=\"\">Select a service</option>\n<option value=\"writing\">Scientific writing</option>\n<option value=\"cme\">CME programme</option>\n<option value=\"consulting\">Pharma consulting</option>\n<option value=\"other\">Other / not sure yet</option>\n</select>\n<span class=\"field__error\">Please choose a service.</span>\n</div>\n<div class=\"field\">\n<label for=\"timeline\">Timeline</label>\n<select id=\"timeline\" name=\"timeline\">\n<option value=\"\">Select a timeline</option>\n<option>Within 1 month</option>\n<option>1 to 3 months</option>\n<option>3 to 6 months</option>\n<option>More than 6 months</option>\n<option>Just exploring</option>\n</select>\n</div>\n</div>\n<div class=\"field\">\n<label for=\"message\">Project details <span class=\"req\">*</span></label>\n<textarea id=\"message\" name=\"message\" placeholder=\"What are you working on, who is the audience, and what would success look like?\" required=\"\"></textarea>\n<span class=\"field__error\">Please tell us a little about your project.</span>\n</div>\n<button class=\"btn btn--primary\" type=\"submit\">\n            Send inquiry\n            <svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg>\n</button>\n<p class=\"form__note\">Your details are only used to respond to your inquiry.</p>\n<div aria-live=\"polite\" class=\"form__status\" role=\"status\"></div>\n</form>\n<aside>\n<div class=\"contact-card\">\n<h3>Get in touch directly</h3>\n<ul class=\"contact-list\">\n<li>\n<span class=\"icon-circle\"><svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><rect height=\"16\" rx=\"2\" width=\"20\" x=\"2\" y=\"4\"></rect><path d=\"m22 7-10 5L2 7\"></path></svg></span>\n<div><small>Email</small><a href=\"mailto:contact@indigo-mx.com\">contact@indigo-mx.com</a><br/></div>\n</li>\n<li>\n<span class=\"icon-circle\"><svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg></span>\n<div><small>Phone</small><a href=\"tel:+639154909223\">+63 915 490 9223</a></div>\n</li>\n<li>\n<span class=\"icon-circle\"><svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg></span>\n<div><small>Office</small><span>INDIGOMX Incorporated Consultancy Service<br/>19 Cordillera St., Burgos, Rodriguez, Rizal, Philippines 1860</span></div>\n</li>\n</ul>\n</div>\n<div class=\"map\">\n<iframe loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.google.com/maps?q=19+Cordillera+St,+Burgos,+Rodriguez,+Rizal,+Philippines+1860&amp;output=embed\" title=\"Map showing 19 Cordillera St., Burgos, Rodriguez, Rizal\"></iframe>\n</div>\n</aside>\n</div>\n</section>"
