 "<section class=\"page-hero page-hero--about\">\n<img alt=\"\" class=\"page-hero__image\" fetchpriority=\"high\" height=\"887\" src=\"assets/img/heroes/about-office.webp\" width=\"1774\"/>\n<div class=\"container\">\n<span class=\"eyebrow\">About IndigoMx</span>\n<h1>Critical synthesis and communication of science, for better health</h1>\n<p>A boutique scientific, healthcare communication and consulting agency, established in June 2019 in the Philippines.</p>\n</div>\n</section>",
 "<section class=\"section\">\n<div class=\"container split split--reverse\">\n<div class=\"reveal\">\n<span class=\"eyebrow\">Who we are</span>\n<h2>Small by design, rigorous by nature</h2>\n<p>IndigoMx was founded by Dr. Ivan Olegario to meet the need for more thoughtful, evidence-based and user-centric healthcare communications and scientific services.</p>\n<p>We work with healthcare organisations across Southeast Asia, the Western Pacific and the Middle East, either directly or in partnership with other scientific partners. As a boutique team, every project gets senior attention from start\n                        to finish.</p>\n<ul class=\"regions\">\n<li><svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Southeast\n                            Asia\n                        </li>\n<li><svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Western Pacific</li>\n<li><svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Middle East</li>\n</ul>\n</div>\n<div class=\"reveal\">\n<img alt=\"IndigoMx logo\" height=\"422\" src=\"assets/img/logo-full.png\" style=\"max-width:420px;margin:0 auto\" width=\"804\"/>\n</div>\n</div>\n</section>",
 "<section class=\"section section--tint\">\n<div class=\"container\">\n<div class=\"section-head\">\n<span class=\"eyebrow\">What drives us</span>\n<h2>Mission, vision and objectives</h2>\n</div>\n<div class=\"mvo\">\n<div class=\"mvo__item reveal\">\n<h3>Mission</h3>\n<p>Critical synthesis and communication of science for better health and healthcare delivery.</p>\n</div>\n<div class=\"mvo__item reveal\">\n<h3>Vision</h3>\n<p>Informed healthcare decision-making and elevated health literacy for all.</p>\n</div>\n<div class=\"mvo__item reveal\">\n<h3>Objectives</h3>\n<p>To provide thoughtful, evidence-based and user-centric healthcare communications and scientific services.</p>\n</div>\n</div>\n</div>\n</section>",
 "<section class=\"section\">\n<div class=\"container split\">\n<div class=\"portrait reveal\">\n<img alt=\"Dr. Ivan Olegario\" height=\"480\" loading=\"lazy\" src=\"assets/img/team/ivan-olegario.jpg\" width=\"480\"/>\n</div>\n<div class=\"bio reveal\">\n<span class=\"eyebrow\">About the founder</span>\n<h2>Ivan Olegario, MD, MDC, CMPP</h2>\n<p>Dr. Ivan Olegario is an ISMPP-certified medical writer with almost 20 years of experience in healthcare communications for private industry, the public health sector and non-governmental organisations.</p>\n<p>As a medical writer, he has worked with healthcare communications agencies including MIMS, McCann Health, Ogilvy/GCI Health, Commune Healthcare, ContentEdNet and Huntsworth Health. In industry, he has experience in medical affairs,\n                        pharmaceutical marketing and sales, business development, strategy, planning and forecasting. He has also led writing groups for ministries of health, medical societies, the World Health Organization and the Joint United Nations\n                        Programme on HIV/AIDS (UNAIDS).</p>\n<p>He earned his medical degree with honours from the University of the Philippines College of Medicine via the accelerated track, followed by a Master of Development Communication from the same university. He also completed the Management\n                        Development Programme of the Asian Institute of Management.</p>\n<ul class=\"creds\">\n<li>MD (with honours)</li>\n<li>Master of Development Communication</li>\n<li>Certified Medical Publication Professional</li>\n<li>AIM Management Development Programme</li>\n</ul>\n</div>\n</div>\n</section>",
 "<section class=\"section section--tint\">\n<div class=\"container\">\n<div class=\"section-head\">\n<span class=\"eyebrow\">Our team</span>\n<h2>The people behind the work</h2>\n<p>Clinicians, researchers and communicators working together on every project.</p>\n</div>\n<div class=\"grid-4\">\n<div class=\"team-card reveal\">\n<img alt=\"Ivan Olegario\" height=\"480\" loading=\"lazy\" src=\"assets/img/team/ivan-olegario.jpg\" width=\"480\"/>\n<h3>Ivan Olegario, MD, MDC, CMPP</h3>\n<p>Proprietor and Lead Consultant</p>\n</div>\n<div class=\"team-card reveal\">\n<img alt=\"Genesis May Samonte\" height=\"480\" loading=\"lazy\" src=\"assets/img/team/genesis-samonte.jpg\" width=\"480\"/>\n<h3>Genesis May Samonte, MD, PHSAE</h3>\n<p>Part-time Consultant, Healthcare Environment, Governance, Policy and Health Economics</p>\n</div>\n<div class=\"team-card reveal\">\n<img alt=\"Blesilda Adlaon\" height=\"480\" loading=\"lazy\" src=\"assets/img/team/blesilda-adlaon.jpg\" width=\"480\"/>\n<h3>Blesilda Adlaon</h3>\n<p>Communications Manager</p>\n</div>\n<div class=\"team-card reveal\">\n<img alt=\"Princess Marie T. Sulit\" height=\"480\" loading=\"lazy\" src=\"assets/img/team/princess-sulit.jpg\" width=\"480\"/>\n<h3>Princess Marie T. Sulit, RN</h3>\n<p>Researcher</p>\n</div>\n</div>\n</div>\n</section>",
 "<section class=\"section\">\n<div class=\"container\">\n<div class=\"section-head section-head--center\">\n<span class=\"eyebrow\">Our clients</span>\n<h2 id=\"client-tabs-title\">Organisations we work with</h2>\n</div>\n<div class=\"client-tabs\">\n<div aria-labelledby=\"client-tabs-title\" class=\"client-tabs__list\" role=\"tablist\">\n<button aria-controls=\"medical-society-panel\" aria-selected=\"true\" class=\"client-tabs__tab\" id=\"medical-society-tab\" role=\"tab\" type=\"button\">Medical Society</button>\n<button aria-controls=\"hospitals-panel\" aria-selected=\"false\" class=\"client-tabs__tab\" id=\"hospitals-tab\" role=\"tab\" tabindex=\"-1\" type=\"button\">Hospitals</button>\n<button aria-controls=\"pharmaceutical-company-panel\" aria-selected=\"false\" class=\"client-tabs__tab\" id=\"pharmaceutical-company-tab\" role=\"tab\" tabindex=\"-1\" type=\"button\">Pharmaceutical Company</button>\n<button aria-controls=\"other-institution-panel\" aria-selected=\"false\" class=\"client-tabs__tab\" id=\"other-institution-tab\" role=\"tab\" tabindex=\"-1\" type=\"button\">Other Institution</button>\n</div>\n<div aria-labelledby=\"medical-society-tab\" class=\"client-tabs__panel\" id=\"medical-society-panel\" role=\"tabpanel\">\n<div class=\"client-wall\">\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Philippine Heart Association Inc</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Philippine College of Physicians</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Asia Pacific Society of Cardiology</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Osteoporosis Society</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Philippine Society for Pediatric Gastroenterology, Hepatology and Nutrition (PSPGHAN)</span></div>\n</div>\n</div>\n<div aria-labelledby=\"hospitals-tab\" class=\"client-tabs__panel\" hidden=\"\" id=\"hospitals-panel\" role=\"tabpanel\">\n<div class=\"client-wall\">\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Philippine General Hospital</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Makati Medical Center</span></div>\n</div>\n</div>\n<div aria-labelledby=\"pharmaceutical-company-tab\" class=\"client-tabs__panel\" hidden=\"\" id=\"pharmaceutical-company-panel\" role=\"tabpanel\">\n<div class=\"client-wall\">\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Boehringer Ingelheim</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Opella</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Takeda</span></div>\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">China Feihe Limited</span></div>\n</div>\n</div>\n<div aria-labelledby=\"other-institution-tab\" class=\"client-tabs__panel\" hidden=\"\" id=\"other-institution-panel\" role=\"tabpanel\">\n<div class=\"client-wall\">\n<div class=\"client-wall__item\"><span class=\"client-wall__name\">Bayer Bayer</span></div>\n</div>\n</div>\n</div>\n</div>\n</section>",
 "<section aria-labelledby=\"consultation-title\" class=\"container consultation-section\">\n<div class=\"cta-band consultation-banner reveal\">\n<h2 id=\"consultation-title\">Let's work together</h2>\n<p class=\"consultation-banner__intro\">Tell us about your project and we'll put together a proposal tailored to your goals.</p>\n<div class=\"cta-band__actions\">\n<a class=\"btn btn--light\" href=\"contact.html\">Book a consultation <svg aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\"><path d=\"M5 12h14m-6-6 6 6-6 6\"></path></svg></a>\n<a class=\"link-arrow consultation-banner__email\" href=\"mailto:contact@indigo-mx.com\">Email us <svg aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\"><path d=\"M5 12h14m-6-6 6 6-6 6\"></path></svg></a>\n</div>\n<div aria-hidden=\"true\" class=\"consultation-orbit\">\n<span class=\"consultation-orbit__ring consultation-orbit__ring--one\"></span>\n<span class=\"consultation-orbit__ring consultation-orbit__ring--two\"></span>\n<span class=\"consultation-orbit__ring consultation-orbit__ring--three\"></span>\n<span class=\"consultation-orbit__sphere\"></span>\n<span class=\"consultation-orbit__dot consultation-orbit__dot--one\"></span>\n<span class=\"consultation-orbit__dot consultation-orbit__dot--two\"></span>\n</div>\n</div>\n</section>"
